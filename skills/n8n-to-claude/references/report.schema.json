{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "n8n-to-claude analyzer report",
  "description": "Output of scripts/analyze.mjs --json. schemaVersion 1: fields may be added; none are renamed or removed without a new version.",
  "type": "object",
  "required": ["schemaVersion", "analyzer", "summary", "workflows"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "analyzer": {
      "type": "object",
      "required": ["version", "nodesMeta"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string" },
        "nodesMeta": { "description": "meta of the nodes.json used: n8n package versions and mapping counts", "type": ["object", "null"] }
      }
    },
    "summary": {
      "type": "object",
      "required": ["workflows", "outcomes", "targets", "wakeups", "blockers", "notAnAutomation", "questions", "unmappedTypes", "cloudScheduledRunsPerHour", "cloudScheduledRunsPerHourLimit", "answers", "inputErrors"],
      "additionalProperties": false,
      "properties": {
        "workflows": { "type": "integer" },
        "outcomes": {
          "description": "workflows per outcome kind; every kind present",
          "type": "object",
          "required": ["subscription", "replaced", "hosted", "keep-in-n8n"],
          "additionalProperties": false,
          "properties": { "subscription": { "type": "integer" }, "replaced": { "type": "integer" }, "hosted": { "type": "integer" }, "keep-in-n8n": { "type": "integer" } }
        },
        "targets": { "description": "workflows per \"<outcome>:<target>\"", "type": "object", "additionalProperties": { "type": "integer" } },
        "wakeups": { "description": "workflows per deciding wake-up kind", "type": "object", "additionalProperties": { "type": "integer" } },
        "blockers": { "description": "workflows having at least one blocker of each kind", "type": "object", "additionalProperties": { "type": "integer" } },
        "notAnAutomation": { "type": "integer" },
        "questions": { "description": "unanswered questions, all workflows", "type": "integer" },
        "unmappedTypes": { "type": "array", "items": { "type": "string" } },
        "cloudScheduledRunsPerHour": { "description": "sum of runsPerDay/24 over subscription:cloud-task workflows with a schedule", "type": "number" },
        "cloudScheduledRunsPerHourLimit": { "description": "capabilities.json thresholds.cloudScheduledRunsPerAccountHour", "type": ["number", "null"] },
        "answers": {
          "type": "object",
          "required": ["used", "unused", "invalid"],
          "additionalProperties": false,
          "properties": {
            "used": { "type": "integer" },
            "unused": { "description": "answer ids that match no question", "type": "array", "items": { "type": "string" } },
            "invalid": { "type": "array", "items": { "type": "object", "required": ["id", "reason"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "reason": { "type": "string" } } } }
          }
        },
        "inputErrors": {
          "description": "files in an input folder that were skipped",
          "type": "array",
          "items": { "type": "object", "required": ["file", "error"], "additionalProperties": false, "properties": { "file": { "type": "string" }, "error": { "type": "string" } } }
        }
      }
    },
    "workflows": { "type": "array", "items": { "$ref": "#/$defs/workflow" } }
  },
  "$defs": {
    "nodes": { "description": "node names in export order", "type": "array", "items": { "type": "string" } },
    "surface": { "description": "ok, needs:<thing>, or no", "type": "string", "pattern": "^(ok|no|needs:[a-z0-9-]+)$" },
    "surfaces": {
      "type": "object",
      "required": ["cloudTask", "localTask", "artifact"],
      "additionalProperties": false,
      "properties": { "cloudTask": { "$ref": "#/$defs/surface" }, "localTask": { "$ref": "#/$defs/surface" }, "artifact": { "$ref": "#/$defs/surface" } }
    },
    "wakeupKind": { "enum": ["endpoint", "mcp-server", "chat", "form", "relay", "poll", "schedule", "subworkflow", "manual", "error"] },
    "outcomeKind": { "enum": ["subscription", "replaced", "hosted", "keep-in-n8n"] },
    "outcomeTarget": {
      "description": "subscription: cloud-task, local-task, skill, artifact-form, artifact (manual or uncalled sub-workflow, only when every requirement is ok in an artifact, else skill); hosted: key, no-key; otherwise null",
      "enum": ["cloud-task", "local-task", "skill", "artifact-form", "artifact", "key", "no-key", null]
    },
    "workflow": {
      "type": "object",
      "required": ["id", "name", "file", "sourceHash", "wakeup", "body", "outcome", "calledBy", "calls", "requires", "questions", "blockers", "credentials", "inlineSecrets", "schedule", "sharedState", "disabled", "steps", "unmapped", "levers"],
      "additionalProperties": false,
      "properties": {
        "id": { "description": "workflow id (template id for an n8n template); a repeated id gets a ~2 suffix", "type": "string" },
        "name": { "type": "string" },
        "file": { "description": "input file relative to the input folder, the file name, or - for stdin", "type": ["string", "null"] },
        "sourceHash": { "description": "sha256 of the workflow object serialised with sorted keys", "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "wakeup": {
          "type": "object",
          "required": ["kind", "nodes", "all"],
          "additionalProperties": false,
          "properties": {
            "kind": { "$ref": "#/$defs/wakeupKind", "description": "the most demanding enabled trigger; manual when there is none" },
            "nodes": { "$ref": "#/$defs/nodes" },
            "all": { "type": "array", "items": { "$ref": "#/$defs/wakeupKind" } }
          }
        },
        "body": {
          "type": "object",
          "required": ["kind", "decidedBy"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["prompt", "script", "script+model"] },
            "decidedBy": { "description": "prompt: model and agent steps; script+model: those plus the steps that are not model, agent or connector; script: empty", "$ref": "#/$defs/nodes" }
          }
        },
        "outcome": {
          "description": "decided by the most demanding wake-up",
          "type": "object",
          "required": ["kind", "target", "reason", "alsoTargets"],
          "additionalProperties": false,
          "properties": {
            "kind": { "$ref": "#/$defs/outcomeKind" },
            "target": { "$ref": "#/$defs/outcomeTarget" },
            "reason": { "type": "string" },
            "alsoTargets": {
              "description": "other trigger kinds of this workflow that need a different target (manual, sub-workflow and error triggers never do); empty when the outcome is keep-in-n8n",
              "type": "array",
              "items": {
                "type": "object",
                "required": ["wakeup", "kind", "target", "nodes"],
                "additionalProperties": false,
                "properties": {
                  "wakeup": { "$ref": "#/$defs/wakeupKind" },
                  "kind": { "$ref": "#/$defs/outcomeKind" },
                  "target": { "$ref": "#/$defs/outcomeTarget" },
                  "nodes": { "$ref": "#/$defs/nodes" }
                }
              }
            }
          }
        },
        "calledBy": { "description": "ids of workflows in this run that call this one", "type": "array", "items": { "type": "string" } },
        "calls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["node", "status", "target"],
            "additionalProperties": false,
            "properties": {
              "node": { "type": "string" },
              "status": { "enum": ["id", "id-answered", "self", "missing", "inline", "expression", "empty", "file", "url"] },
              "target": { "type": ["string", "null"] }
            }
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "name", "nodes", "surfaces"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["connector", "model", "http", "secret", "db", "vector", "state", "mcp-server", "poll", "relay", "host-disk", "substitution", "missing-export", "frequency-change", "bundled-server"] },
              "name": { "description": "connector id, credential name (never a value), inline:<secret kind>, db or vector node type, state key, MCP host, trigger type, or a description", "type": "string" },
              "nodes": { "description": "nodes of this workflow that need it; for what a sub-workflow needs, the calling node", "$ref": "#/$defs/nodes" },
              "surfaces": { "$ref": "#/$defs/surfaces" },
              "operations": { "description": "connector only: \"<node type> <resource:operation>\"", "type": "array", "items": { "type": "string" } },
              "confirmed": { "description": "connector only: every operation confirmed on a real account (Phase 0)", "type": "boolean" }
            }
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "text", "nodes", "affects", "answerType", "options", "assumed", "answer"],
            "additionalProperties": false,
            "properties": {
              "id": { "description": "<workflow id>/<kind>[/<node path>]; the key for --answers. A node path inside an inline sub-workflow is \"<call node> › <node>\"", "type": "string" },
              "text": { "type": "string" },
              "nodes": { "$ref": "#/$defs/nodes" },
              "affects": { "enum": ["outcome", "effect", "timezone", "sub-workflow", "schedule"] },
              "answerType": { "description": "nodes: true (every listed node), false (none) or a list of the listed node names", "enum": ["boolean", "choice", "text", "nodes"] },
              "options": { "description": "accepted answer → what it changes; <placeholder> keys stand for free text", "type": "object", "additionalProperties": { "type": "string" } },
              "assumed": { "description": "value the report uses while unanswered" },
              "answer": { "description": "the valid answer from --answers, else null" }
            }
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "reason", "nodes"],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "description": "input-incomplete, unsupported and unmapped make the outcome keep-in-n8n; the others do not",
                "enum": ["input-incomplete", "unsupported", "unmapped", "substitution", "dropped-branch", "not-an-automation"]
              },
              "reason": { "type": "string" },
              "nodes": { "$ref": "#/$defs/nodes" }
            }
          }
        },
        "credentials": {
          "description": "credentials referenced by enabled nodes, inline sub-workflows included (node path \"<call node> › <node>\"): type and name only",
          "type": "array",
          "items": { "type": "object", "required": ["type", "name", "nodes"], "additionalProperties": false, "properties": { "type": { "type": "string" }, "name": { "type": "string" }, "nodes": { "$ref": "#/$defs/nodes" } } }
        },
        "inlineSecrets": {
          "description": "secret-looking literals in parameters or pinData; never the value",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["node", "path", "kind", "redacted"],
            "additionalProperties": false,
            "properties": {
              "node": { "type": "string" },
              "path": { "description": "parameters.<path> or pinData.<node>…", "type": "string" },
              "kind": { "enum": ["anthropic", "stripe", "openai", "slack", "slack-webhook", "google", "github", "aws", "telegram", "jwt", "bearer", "query-param", "key-value", "named-param"] },
              "redacted": { "description": "first 4 characters, …, length", "type": "string", "pattern": "^.{0,4}…[0-9]+$" }
            }
          }
        },
        "schedule": {
          "type": "object",
          "required": ["runsPerDay", "shortestIntervalSec", "fits", "timezone", "timezoneSource"],
          "additionalProperties": false,
          "properties": {
            "runsPerDay": { "description": "all enabled schedule and poll triggers together; null without them", "type": ["number", "null"] },
            "shortestIntervalSec": { "description": "null without time triggers or with fewer than two fires a year", "type": ["integer", "null"] },
            "fits": { "enum": ["cloud-task", "local-task", "frequency-change", "n/a"] },
            "timezone": { "type": "string" },
            "timezoneSource": { "enum": ["workflow", "answer", "n8n-default"] }
          }
        },
        "sharedState": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "name", "nodes", "sharedWith"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["data-table", "static-data", "dedupe-history", "chat-memory", "process-memory", "vector-memory", "self-call"] },
              "name": { "type": "string" },
              "nodes": { "$ref": "#/$defs/nodes" },
              "sharedWith": { "description": "data-table and vector-memory: other workflow ids in this run using the same table or key", "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "disabled": { "description": "disabled nodes: ignored, listed", "$ref": "#/$defs/nodes" },
        "steps": { "description": "every enabled node except sticky notes, in export order", "type": "array", "items": { "$ref": "#/$defs/step" } },
        "unmapped": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["node", "type", "typeVersion", "reason", "branch"],
            "additionalProperties": false,
            "properties": {
              "node": { "type": "string" },
              "type": { "type": "string" },
              "typeVersion": { "description": "null when the export's value is not a number", "type": ["number", "null"] },
              "reason": { "enum": ["not-in-catalogue", "unmapped"] },
              "branch": { "enum": ["main", "error", "unreached"] }
            }
          }
        },
        "levers": { "description": "levers (mappings.json vocabulary, plus llm-api: an LLM API called over HTTP that can run on the subscription instead of a key) the workflow needs, sub-workflows included", "type": "array", "items": { "type": "string" } }
      }
    },
    "step": {
      "type": "object",
      "required": ["node", "type", "typeVersion", "role", "branch", "resource", "operation", "kind", "effect", "effectBy", "levers", "mapping", "issues"],
      "additionalProperties": false,
      "properties": {
        "node": { "type": "string" },
        "type": { "type": "string" },
        "typeVersion": { "description": "null when the export's value is not a number", "type": ["number", "null"] },
        "role": { "enum": ["trigger", "step", "subnode", "n8n-internal", "unknown"] },
        "branch": { "description": "main: runs when an enabled trigger fires; error: only behind an error output or an Error Trigger; unreached: never runs", "enum": ["main", "error", "unreached"] },
        "resource": { "type": ["string", "null"] },
        "operation": { "type": ["string", "null"] },
        "kind": { "description": "mappings.json kind", "type": ["string", "null"] },
        "effect": { "description": "null for triggers and internal nodes without one", "enum": ["read", "write", "none", "unknown", null] },
        "effectBy": { "description": "hand (mappings.json), name (operation-name table), parse (SQL or code read), host (http-hosts.json rule), assumed (undetermined, counted as a write until the writes question is answered), answer", "enum": ["hand", "name", "parse", "host", "assumed", "answer", null] },
        "levers": { "type": "array", "items": { "type": "string" } },
        "mapping": { "enum": ["hand", "name", "unmapped"] },
        "issues": { "type": "array", "items": { "enum": ["not-in-catalogue", "unknown-version", "unknown-operation", "expression-operation"] } }
      }
    }
  }
}
