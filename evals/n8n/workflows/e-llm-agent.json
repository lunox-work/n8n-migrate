{
  "name": "bench e: AI Agent with a tool on the Anthropic model node",
  "nodes": [
    { "id": "e1", "name": "Start", "type": "n8n-nodes-base.manualTrigger", "typeVersion": 1, "position": [0, 0], "parameters": {} },
    {
      "id": "e2", "name": "Agent", "type": "@n8n/n8n-nodes-langchain.agent", "typeVersion": 3.1, "position": [220, 0],
      "parameters": { "promptType": "define", "text": "={{ $json.question }}", "options": { "systemMessage": "You answer stock questions using the tool." } }
    },
    {
      "id": "e3", "name": "Claude", "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic", "typeVersion": 1.6, "position": [100, 200],
      "parameters": { "model": { "__rl": true, "mode": "id", "value": "claude-sonnet-5" }, "options": {} },
      "credentials": { "anthropicApi": { "id": "benchAnthropic01", "name": "Bench Anthropic" } }
    },
    {
      "id": "e4", "name": "Stock lookup", "type": "@n8n/n8n-nodes-langchain.toolCode", "typeVersion": 1.3, "position": [340, 200],
      "parameters": { "description": "Returns units in stock for a SKU. Input: the SKU string.", "jsCode": "const stock = { 'SKU-1': 12, 'SKU-2': 0 };\nreturn String(stock[query] ?? 'unknown');" }
    }
  ],
  "connections": {
    "Start": { "main": [[{ "node": "Agent", "type": "main", "index": 0 }]] },
    "Claude": { "ai_languageModel": [[{ "node": "Agent", "type": "ai_languageModel", "index": 0 }]] },
    "Stock lookup": { "ai_tool": [[{ "node": "Agent", "type": "ai_tool", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
