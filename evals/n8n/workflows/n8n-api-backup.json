{
  "name": "n8n API check: nightly workflow backup (pared down)",
  "nodes": [
    { "id": "k1", "name": "Schedule Trigger", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [0, 0], "parameters": { "rule": { "interval": [{ "triggerAtHour": 1, "triggerAtMinute": 33 }] } } },
    { "id": "k2", "name": "n8n", "type": "n8n-nodes-base.n8n", "typeVersion": 1, "position": [220, -200], "parameters": { "filters": {}, "requestOptions": {} }, "credentials": { "n8nApi": { "id": "credential-id", "name": "n8nApi Credential" } } },
    {
      "id": "k3", "name": "Backup files", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [440, -200],
      "parameters": { "jsCode": "const ordered = (o) => Object.fromEntries(Object.keys(o).sort().map((k) => [k, o[k]]));\nreturn $input.all().map((item) => ({ json: { path: `backups/${item.json.id}.json`, name: item.json.name, nodes: (item.json.nodes || []).length, content: JSON.stringify(ordered(item.json), null, 2) } }));" }
    },
    { "id": "k4", "name": "Tagged workflows", "type": "n8n-nodes-base.n8n", "typeVersion": 1, "position": [220, 0], "parameters": { "returnAll": false, "limit": 50, "filters": { "activeWorkflows": false, "tags": "n2c-api-check" }, "requestOptions": {} }, "credentials": { "n8nApi": { "id": "credential-id", "name": "n8nApi Credential" } } },
    { "id": "k5", "name": "Get workflow", "type": "n8n-nodes-base.n8n", "typeVersion": 1, "position": [440, 0], "parameters": { "operation": "get", "workflowId": { "__rl": true, "mode": "id", "value": "={{ $json.id }}" }, "requestOptions": {} }, "credentials": { "n8nApi": { "id": "credential-id", "name": "n8nApi Credential" } } },
    { "id": "k6", "name": "Successful runs", "type": "n8n-nodes-base.n8n", "typeVersion": 1, "position": [440, 200], "parameters": { "resource": "execution", "filters": { "workflowId": { "__rl": true, "mode": "id", "value": "={{ $json.id }}" }, "status": "success" }, "options": {}, "requestOptions": {} }, "credentials": { "n8nApi": { "id": "credential-id", "name": "n8nApi Credential" } } },
    { "id": "k7", "name": "Get execution", "type": "n8n-nodes-base.n8n", "typeVersion": 1, "position": [660, 200], "parameters": { "resource": "execution", "operation": "get", "executionId": "={{ $json.id }}", "options": { "activeWorkflows": true }, "requestOptions": {} }, "credentials": { "n8nApi": { "id": "credential-id", "name": "n8nApi Credential" } } },
    { "id": "k8", "name": "Failed runs", "type": "n8n-nodes-base.n8n", "typeVersion": 1, "position": [220, 400], "parameters": { "resource": "execution", "returnAll": true, "filters": { "status": "error" }, "options": {}, "requestOptions": {} }, "credentials": { "n8nApi": { "id": "credential-id", "name": "n8nApi Credential" } } }
  ],
  "connections": {
    "Schedule Trigger": { "main": [[{ "node": "n8n", "type": "main", "index": 0 }, { "node": "Tagged workflows", "type": "main", "index": 0 }, { "node": "Failed runs", "type": "main", "index": 0 }]] },
    "n8n": { "main": [[{ "node": "Backup files", "type": "main", "index": 0 }]] },
    "Tagged workflows": { "main": [[{ "node": "Get workflow", "type": "main", "index": 0 }, { "node": "Successful runs", "type": "main", "index": 0 }]] },
    "Successful runs": { "main": [[{ "node": "Get execution", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
