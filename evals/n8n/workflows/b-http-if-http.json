{
  "name": "bench b: http, if, http",
  "nodes": [
    { "id": "b1", "name": "Start", "type": "n8n-nodes-base.manualTrigger", "typeVersion": 1, "position": [0, 0], "parameters": {} },
    {
      "id": "b2", "name": "Get orders", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [220, 0],
      "parameters": { "url": "http://mock:8080/api/orders", "sendQuery": true, "queryParameters": { "parameters": [{ "name": "since", "value": "={{ $json.since || '2026-11-01' }}" }] }, "options": {} }
    },
    {
      "id": "b3", "name": "Open?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [440, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [{ "id": "c1", "leftValue": "={{ $json.status }}", "rightValue": "open", "operator": { "type": "string", "operation": "equals" } }],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "b4", "name": "Notify", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [660, -100],
      "parameters": {
        "method": "POST", "url": "http://mock:8080/api/notify",
        "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth",
        "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ orderId: $json.id, text: 'Order ' + $json.id + ' is open' }) }}",
        "options": {}
      },
      "credentials": { "httpHeaderAuth": { "id": "benchCred0000001", "name": "Bench Token" } }
    },
    {
      "id": "b5", "name": "Archive", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [660, 100],
      "parameters": { "method": "POST", "url": "http://mock:8080/api/archive", "sendBody": true, "bodyParameters": { "parameters": [{ "name": "orderId", "value": "={{ $json.id }}" }] }, "options": {} }
    }
  ],
  "connections": {
    "Start": { "main": [[{ "node": "Get orders", "type": "main", "index": 0 }]] },
    "Get orders": { "main": [[{ "node": "Open?", "type": "main", "index": 0 }]] },
    "Open?": { "main": [[{ "node": "Notify", "type": "main", "index": 0 }], [{ "node": "Archive", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
