{
  "id": "multiple-triggers",
  "name": "Lead intake",
  "active": false,
  "nodes": [
    {
      "id": "00000000-0000-4000-8000-000000000073",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        16060,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "lead",
        "options": {}
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000074",
      "name": "Daily 8:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        16280,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 8
            }
          ]
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000075",
      "name": "When clicking 'Execute workflow'",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        16500,
        300
      ],
      "parameters": {}
    },
    {
      "id": "00000000-0000-4000-8000-000000000076",
      "name": "Shape lead",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        16720,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "text",
              "value": "=Lead: {{ $json.body.email }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000077",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        16940,
        300
      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#leads"
        },
        "text": "={{ $json.text }}"
      },
      "credentials": {
        "slackOAuth2Api": {
          "id": "cred-slackOAuth2Api",
          "name": "Slack bot"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Shape lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Daily 8:00": {
      "main": [
        [
          {
            "node": "Shape lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "When clicking 'Execute workflow'": {
      "main": [
        [
          {
            "node": "Shape lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Shape lead": {
      "main": [
        [
          {
            "node": "Post to Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
