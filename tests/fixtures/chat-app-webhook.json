[
  {
    "id": "cw-telegram",
    "name": "Support bot behind a webhook",
    "active": false,
    "nodes": [
      {
        "id": "00000000-0000-4000-8000-000000002501",
        "name": "Telegram updates",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [
          220,
          300
        ],
        "parameters": {
          "httpMethod": "POST",
          "path": "tg",
          "options": {}
        }
      },
      {
        "id": "00000000-0000-4000-8000-000000002502",
        "name": "Has text?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [
          440,
          300
        ],
        "parameters": {
          "conditions": {
            "combinator": "and",
            "conditions": [
              {
                "leftValue": "={{ $json.body.message.text }}",
                "operator": {
                  "type": "string",
                  "operation": "notEmpty",
                  "singleValue": true
                }
              }
            ]
          },
          "options": {}
        }
      },
      {
        "id": "00000000-0000-4000-8000-000000002503",
        "name": "Bot brain",
        "type": "@n8n/n8n-nodes-langchain.agent",
        "typeVersion": 1.7,
        "position": [
          660,
          300
        ],
        "parameters": {
          "promptType": "define",
          "text": "={{ $json.body.message.text }}"
        }
      },
      {
        "id": "00000000-0000-4000-8000-000000002504",
        "name": "Claude",
        "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
        "typeVersion": 1.3,
        "position": [
          880,
          300
        ],
        "parameters": {
          "model": {
            "__rl": true,
            "mode": "list",
            "value": "claude-sonnet-4-5"
          }
        },
        "credentials": {
          "anthropicApi": {
            "id": "cred-anthropicApi",
            "name": "Anthropic"
          }
        }
      },
      {
        "id": "00000000-0000-4000-8000-000000002505",
        "name": "Answer",
        "type": "n8n-nodes-base.telegram",
        "typeVersion": 1.2,
        "position": [
          1100,
          300
        ],
        "parameters": {
          "chatId": "={{ $('Telegram updates').item.json.body.message.chat.id }}",
          "text": "={{ $json.output }}",
          "additionalFields": {}
        },
        "credentials": {
          "telegramApi": {
            "id": "cred-telegramApi",
            "name": "Support bot"
          }
        }
      },
      {
        "id": "00000000-0000-4000-8000-000000002506",
        "name": "Sorry",
        "type": "n8n-nodes-base.telegram",
        "typeVersion": 1.2,
        "position": [
          1320,
          300
        ],
        "parameters": {
          "chatId": "={{ $json.body.message.chat.id }}",
          "text": "Text only, please.",
          "additionalFields": {}
        },
        "credentials": {
          "telegramApi": {
            "id": "cred-telegramApi",
            "name": "Support bot"
          }
        }
      }
    ],
    "connections": {
      "Telegram updates": {
        "main": [
          [
            {
              "node": "Has text?",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Has text?": {
        "main": [
          [
            {
              "node": "Bot brain",
              "type": "main",
              "index": 0
            }
          ],
          [
            {
              "node": "Sorry",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Bot brain": {
        "main": [
          [
            {
              "node": "Answer",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Claude": {
        "ai_languageModel": [
          [
            {
              "node": "Bot brain",
              "type": "ai_languageModel",
              "index": 0
            }
          ]
        ]
      }
    },
    "settings": {
      "executionOrder": "v1"
    }
  },
  {
    "id": "cw-telegram-owner",
