        "type": "@n8n/n8n-nodes-langchain.agent",
        "typeVersion": 1.7,
        "position": [
          440,
          300
        ],
        "parameters": {
          "promptType": "define",
          "text": "={{ $json.body.entry[0].changes[0].value.messages[0].text.body }}"
