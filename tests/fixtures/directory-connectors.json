{
  "id": "directory-connectors",
  "name": "Morning bug triage",
  "active": false,
  "nodes": [
    {
      "id": "00000000-0000-4000-8000-000000002001",
      "name": "Every morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 8
            }
          ]
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000002002",
      "name": "Open bugs",
      "type": "n8n-nodes-base.jira",
      "typeVersion": 1,
      "position": [
        440,
        300
      ],
      "parameters": {
        "resource": "issue",
        "operation": "getAll",
        "options": {
          "jql": "type = Bug AND status = Open"
        }
      },
      "credentials": {
        "jiraSoftwareCloudApi": {
          "id": "cred-jiraSoftwareCloudApi",
          "name": "Jira work"
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000002003",
      "name": "Delete duplicates",
      "type": "n8n-nodes-base.jira",
      "typeVersion": 1,
      "position": [
        660,
        300
      ],
      "parameters": {
        "resource": "issue",
        "operation": "delete",
        "issueKey": "={{ $json.key }}"
      },
      "credentials": {
        "jiraSoftwareCloudApi": {
          "id": "cred-jiraSoftwareCloudApi",
          "name": "Jira work"
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000002004",
      "name": "Find reporter",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2.2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "authentication": "appToken",
        "resource": "contact",
        "operation": "search"
      },
      "credentials": {
        "hubspotAppToken": {
          "id": "cred-hubspotAppToken",
          "name": "HubSpot app"
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000002005",
      "name": "Create task",
      "type": "n8n-nodes-base.clickUp",
      "typeVersion": 1.1,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "team": "1",
        "space": "2",
        "list": "3",
        "name": "={{ $json.fields.summary }}"
      },
      "credentials": {
        "clickUpApi": {
          "id": "cred-clickUpApi",
          "name": "ClickUp"
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000002006",
      "name": "Triage agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Which open deal is linked to {{ $json.email }}?"
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000002007",
      "name": "Claude",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "claude-sonnet-4-5"
        }
      },
      "credentials": {
        "anthropicApi": {
          "id": "cred-anthropicApi",
          "name": "Anthropic"
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000002008",
      "name": "Deals",
      "type": "n8n-nodes-base.hubspotTool",
      "typeVersion": 2.2,
      "position": [
        1760,
        300
      ],
      "parameters": {
        "authentication": "appToken",
        "resource": "deal",
        "operation": "search"
      },
      "credentials": {
        "hubspotAppToken": {
          "id": "cred-hubspotAppToken",
          "name": "HubSpot app"
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000002009",
      "name": "Append report",
      "type": "n8n-nodes-base.confluence",
      "typeVersion": 1,
      "position": [
        1980,
        300
      ],
      "parameters": {
        "resource": "page",
        "operation": "append",
        "pageId": "123"
      },
      "credentials": {
        "confluenceCloudApi": {
          "id": "cred-confluenceCloudApi",
          "name": "Confluence"
        }
      }
    }
  ],
  "connections": {
    "Every morning": {
      "main": [
        [
          {
            "node": "Open bugs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Open bugs": {
      "main": [
        [
          {
            "node": "Delete duplicates",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Delete duplicates": {
      "main": [
        [
          {
            "node": "Find reporter",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find reporter": {
      "main": [
        [
          {
            "node": "Create task",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create task": {
      "main": [
        [
          {
            "node": "Triage agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Triage agent": {
      "main": [
        [
          {
            "node": "Append report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude": {
      "ai_languageModel": [
        [
          {
            "node": "Triage agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Deals": {
      "ai_tool": [
        [
          {
            "node": "Triage agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Berlin"
  }
}
