[
  {
    "id": "rv-default",
    "name": "New payment to Slack",
    "active": false,
    "nodes": [
      {
        "id": "00000000-0000-4000-8000-000000003001",
        "name": "Stripe Trigger",
        "type": "n8n-nodes-base.stripeTrigger",
        "typeVersion": 1,
        "position": [
          220,
          300
        ],
        "parameters": {
          "events": [
            "charge.succeeded"
          ]
        },
        "credentials": {
          "stripeApi": {
            "id": "cred-stripeApi",
            "name": "Stripe"
          }
        }
      },
      {
        "id": "00000000-0000-4000-8000-000000003002",
        "name": "Tell sales",
        "type": "n8n-nodes-base.slack",
        "typeVersion": 2.3,
        "position": [
          440,
          300
        ],
        "parameters": {
          "select": "channel",
          "channelId": {
            "__rl": true,
            "mode": "name",
            "value": "#sales"
          },
          "text": "=Paid: {{ $json.data.object.amount }}"
        },
        "credentials": {
          "slackOAuth2Api": {
            "id": "cred-slackOAuth2Api",
            "name": "Slack"
          }
        }
      }
    ],
    "connections": {
      "Stripe Trigger": {
        "main": [
          [
            {
              "node": "Tell sales",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    },
    "settings": {
      "executionOrder": "v1"
    }
  },
