{
  "id": "poll-every-minute",
  "name": "Auto-reply to support mail",
  "active": false,
  "nodes": [
    {
      "id": "00000000-0000-4000-8000-000000000020",
      "name": "New support mail",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [
        4400,
        300
      ],
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "filters": {
          "q": "to:support@example.com"
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "cred-gmailOAuth2",
          "name": "Gmail support"
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000021",
      "name": "Support agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        4620,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.snippet }}",
        "options": {}
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000022",
      "name": "OpenAI model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        4840,
        300
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "options": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "cred-openAiApi",
          "name": "OpenAI"
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000023",
      "name": "Reply",
      "type": "n8n-nodes-base.gmailTool",
      "typeVersion": 2.1,
      "position": [
        5060,
        300
      ],
      "parameters": {
        "operation": "reply",
        "messageId": "={{ $fromAI('id') }}",
        "message": "={{ $fromAI('body') }}",
        "options": {}
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "cred-gmailOAuth2",
          "name": "Gmail support"
        }
      }
    }
  ],
  "connections": {
    "New support mail": {
      "main": [
        [
          {
            "node": "Support agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI model": {
      "ai_languageModel": [
        [
          {
            "node": "Support agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Reply": {
      "ai_tool": [
        [
          {
            "node": "Support agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
