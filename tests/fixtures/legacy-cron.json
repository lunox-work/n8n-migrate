{
  "id": "legacy-cron",
  "name": "Feed watcher (old cron node)",
  "active": false,
  "nodes": [
    {
      "id": "00000000-0000-4000-8000-000000000015",
      "name": "Cron",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        3300,
        300
      ],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyX",
              "value": 15,
              "unit": "minutes"
            },
            {
              "hour": 9
            }
          ]
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000016",
      "name": "Read feed",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [
        3520,
        300
      ],
      "parameters": {
        "url": "https://blog.example.com/feed.xml",
        "options": {}
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000017",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        3740,
        300
      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#feed"
        },
        "text": "={{ $json.title }}"
      },
      "credentials": {
        "slackOAuth2Api": {
          "id": "cred-slackOAuth2Api",
          "name": "Slack bot"
        }
      }
    }
  ],
  "connections": {
    "Cron": {
      "main": [
        [
          {
            "node": "Read feed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read feed": {
      "main": [
        [
          {
            "node": "Post to Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/London"
  }
}
