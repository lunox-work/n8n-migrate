{
  "id": "unsupported",
  "name": "Disk check with approval",
  "active": false,
  "nodes": [
    {
      "id": "00000000-0000-4000-8000-000000000055",
      "name": "Daily 6:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        12100,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 6
            }
          ]
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000056",
      "name": "Check disk",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        12320,
        300
      ],
      "parameters": {
        "command": "df -h /"
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000057",
      "name": "Wait for approval",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        12540,
        300
      ],
      "parameters": {
        "resume": "webhook",
        "options": {}
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000058",
      "name": "Post result",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        12760,
        300
      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#ops"
        },
        "text": "={{ $json.stdout }}"
      },
      "credentials": {
        "slackOAuth2Api": {
          "id": "cred-slackOAuth2Api",
          "name": "Slack bot"
        }
      }
    }
  ],
  "connections": {
    "Daily 6:00": {
      "main": [
        [
          {
            "node": "Check disk",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check disk": {
      "main": [
        [
          {
            "node": "Wait for approval",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait for approval": {
      "main": [
        [
          {
            "node": "Post result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC"
  }
}
