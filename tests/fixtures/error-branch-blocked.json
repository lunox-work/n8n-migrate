{
  "id": "error-branch-blocked",
  "name": "Fetch with fallback",
  "active": false,
  "nodes": [
    {
      "id": "00000000-0000-4000-8000-000000000069",
      "name": "Every hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        15180,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours"
            }
          ]
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000070",
      "name": "Fetch status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        15400,
        300
      ],
      "parameters": {
        "url": "https://status.example.com/api.json",
        "options": {}
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "00000000-0000-4000-8000-000000000071",
      "name": "Keep fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        15620,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "status",
              "value": "={{ $json.status }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000072",
      "name": "Log failure locally",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        15840,
        300
      ],
      "parameters": {
        "command": "logger 'status fetch failed'"
      }
    }
  ],
  "connections": {
    "Every hour": {
      "main": [
        [
          {
            "node": "Fetch status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch status": {
      "main": [
        [
          {
            "node": "Keep fields",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log failure locally",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC"
  }
