      "typeVersion": 4.2,
      "position": [
        133320,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://tasks.example.com/api/{{ $json.board }}/cards",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "cred-httpHeaderAuth",
          "name": "Tasks"
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000607",
      "name": "Notify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        133540,
        300
      ],
      "parameters": {
        "method": "={{ $json.verb }}",
        "url": "https://hooks.example.com/notify",
        "options": {}
      }
    }
