{
  "id": "schedule-local-script",
  "name": "Sync orders to warehouse",
  "active": false,
  "nodes": [
    {
      "id": "00000000-0000-4000-8000-000000000006",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes"
            }
          ]
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000007",
      "name": "Fetch orders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "url": "https://api.example.com/orders",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "cred-httpHeaderAuth",
          "name": "Orders API"
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000008",
      "name": "Pick fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        300
      ],
      "parameters": {
        "jsCode": "return $input.all().map(i => ({ json: { id: i.json.id, total: i.json.total } }));"
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000009",
      "name": "Insert rows",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1980,
        300
      ],
      "parameters": {
        "schema": {
          "__rl": true,
          "mode": "list",
          "value": "public"
        },
        "table": {
          "__rl": true,
          "mode": "list",
          "value": "orders"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "cred-postgres",
          "name": "Warehouse DB"
        }
      }
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [
        [
          {
            "node": "Fetch orders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch orders": {
      "main": [
        [
          {
            "node": "Pick fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pick fields": {
      "main": [
        [
          {
            "node": "Insert rows",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
